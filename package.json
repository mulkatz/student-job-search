{
  "name": "student-job-search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.22.0",
    "npm": "11.11.0"
  },
  "workspaces": [
    "packages/core",
    "packages/experiment"
  ],
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces && node --test scripts/test/*.test.mjs",
    "build": "npm run build --workspaces",
    "secrets": "node scripts/scan-secrets.mjs",
    "verify": "npm run check:runtime && npm run check && npm run typecheck && npm test && npm run build && npm run secrets",
    "check": "biome ci . --error-on-warnings",
    "experiment": "npm run build --workspace=@job-search/experiment && node packages/experiment/dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@secretlint/node": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
