{
  "name": "student-job-search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.22.0",
    "npm": "11.11.0"
  },
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "secrets": "node scripts/scan-secrets.mjs",
    "verify": "npm run check:runtime && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run secrets"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
