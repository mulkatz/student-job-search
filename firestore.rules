rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sharedJobs/{jobId} {
      // Shared projections are read through the authenticated API, which enforces retention.
      allow read: if false;
      allow write: if false;
    }
    match /users/{ownerId}/preferences/discovery {
      allow read: if request.auth != null && request.auth.uid == ownerId
        && (!exists(/databases/$(database)/documents/users/$(ownerId)/profileState/current)
          || get(/databases/$(database)/documents/users/$(ownerId)/profileState/current).data.lifecycle == 'active');
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
