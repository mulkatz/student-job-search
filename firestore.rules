rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sharedJobs/{jobId} {
      // Shared projections are read through the authenticated API, which enforces retention.
      allow read: if false;
      allow write: if false;
    }
    match /users/{ownerId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == ownerId;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
